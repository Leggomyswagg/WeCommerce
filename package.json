{
  "name": "hybridmentorops-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers",
    "packages/*/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @hmo/web run dev",
    "dev:api": "npm --workspace @hmo/api run dev",
    "dev:workers": "npm --workspace @hmo/workers run dev",
    "build": "npm run -ws --if-present build",
    "test": "npm run -ws test --if-present"
  },
  "dependencies": {
    "@hmo/shopify-connector": "*",
    "@hmo/stripe-connector": "*"
  }
}
