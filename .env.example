# Founder workspace. Generate a long random token; keep it server-side except
# when entering it into the dashboard's memory-only access form.
WE_COMMERCE_AUTH_TOKEN=
# PostgreSQL is required in production/serverless. Run npm run db:setup
# explicitly against the intended database before starting the application.
DATABASE_URL=
# Optional development-only local persistence directory:
WE_COMMERCE_DATA_DIR=

# Shopify Admin API (read_products), not a browser Storefront token
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# WooCommerce REST read credentials
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# CJ read-only catalogue requests. Configure/refresh this token securely.
CJ_ACCESS_TOKEN=

# Advertising reads. Choose a provider-supported API version explicitly.
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Existing Stripe configuration indicator only; no billing flow is implemented.
STRIPE_SECRET_KEY=

# Ports
PORT=3000
API_PORT=4000
