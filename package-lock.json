{
  "name": "hybridmentorops-monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "hybridmentorops-monorepo",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "workers",
        "packages/*/*"
      ]
    },
    "apps/api": {
      "name": "@hmo/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@hmo/web",
      "version": "0.1.0"
    },
    "node_modules/@hmo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@hmo/shopify-connector": {
      "resolved": "packages/connectors/shopify",
      "link": true
    },
    "node_modules/@hmo/stripe-connector": {
      "resolved": "packages/connectors/stripe",
      "link": true
    },
    "node_modules/@hmo/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@hmo/workers": {
      "resolved": "workers",
      "link": true
    },
    "packages/connectors/shopify": {
      "name": "@hmo/shopify-connector",
      "version": "0.1.0"
    },
    "packages/connectors/stripe": {
      "name": "@hmo/stripe-connector",
      "version": "0.1.0"
    },
    "workers": {
      "name": "@hmo/workers",
      "version": "0.1.0"
    }
  }
}
